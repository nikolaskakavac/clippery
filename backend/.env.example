FRONTEND_ORIGIN=http://localhost:3000
JOB_ROOT=./tmp/jobs
JOB_TTL_SECONDS=3600

# Temporarily enable provider/runtime diagnostics in server logs.
YTDLP_DIAGNOSTICS=0

# Optional, secret Netscape-format youtube.com cookies; Base64 takes precedence.
YOUTUBE_COOKIES_BASE64=
# Local development only; ignored source file is copied into a private temp file.
YOUTUBE_COOKIES_FILE=
